<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
    <linearGradient id="quantum" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00d4ff"/>
      <stop offset="100%" style="stop-color:#7b2cbf"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <circle cx="400" cy="300" r="80" fill="none" stroke="url(#quantum)" stroke-width="2" opacity="0.6"/>
  <circle cx="400" cy="300" r="120" fill="none" stroke="url(#quantum)" stroke-width="1.5" opacity="0.4"/>
  <circle cx="400" cy="300" r="160" fill="none" stroke="url(#quantum)" stroke-width="1" opacity="0.2"/>
  <circle cx="400" cy="300" r="8" fill="#00d4ff"/>
  <text x="400" y="540" font-family="Arial" font-size="14" fill="#ffffff60" text-anchor="middle">Computación Cuántica</text>
</svg>